# ==========================================
# Session secret (required)
# ==========================================
# Used to sign the admin session cookie (see express-session in server.js). Must be a
# long random value, unique per deployment, and never committed to source control.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Copy this file to ".env" (git-ignored) and paste a freshly generated value in below --
# do not reuse the example/placeholder value, and do not reuse the same secret across
# environments (dev/production should each have their own).
SESSION_SECRET=

# Set to "production" on the real deployment (Raspberry Pi behind Caddy) so the session
# cookie requires HTTPS (Secure flag). Leave unset for local development over plain HTTP.
NODE_ENV=

# ==========================================
# Database credentials (DB_PASSWORD required, rest optional)
# ==========================================
# Both server.js (the pg Pool) and docker-compose.yml (the Postgres container) read
# DB_PASSWORD from here, so they always agree and nothing is hardcoded in source control.
# Pick any value for a fresh deployment; for an existing database, it must match whatever
# password that Postgres instance's "tooladmin" user already has.
DB_PASSWORD=

# These four are optional -- server.js falls back to the same defaults docker-compose.yml
# uses (tooladmin / localhost / tooltracker / 5432) if left unset. Only override them if
# your setup genuinely differs (e.g. Postgres running on another host).
DB_USER=
DB_HOST=
DB_NAME=
DB_PORT=

# ==========================================
# Storage path (optional)
# ==========================================
# Where uploaded photos (public/uploads/), logs (logs/), and the Postgres database itself
# (postgres_data/, see docker-compose.yml) are written. Leave unset for local PC dev --
# defaults to this project's own directory. On the Raspberry Pi, set this to the external
# drive's mount point instead, e.g.:
#   BASE_STORAGE_PATH=/mnt/external_drive/ToolTracker_Data
# This is the only thing that differs between the PC and the Pi now -- server.js itself is
# identical on both, so `git pull` on the Pi never conflicts with an environment-specific
# code edit. Putting the database here too (not just photos/logs) matters on the Pi
# specifically: SD cards fail far more often than a proper external drive, and a Docker-
# managed volume for Postgres defaults to living on the SD card unless redirected.
BASE_STORAGE_PATH=

# ==========================================
# Calendar feed token (optional)
# ==========================================
# Gates GET /api/calendar/calibration.ics -- a read-only iCalendar feed of every calibrated
# tool's due date, meant to be subscribed to from Google/Outlook/Apple Calendar. There's no
# login session on that endpoint (a calendar app auto-refreshing a URL can't do interactive
# auth), so this token IS the entire access control; leaving it unset disables the feed
# entirely rather than leaving it open. Generate one the same way as SESSION_SECRET:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CALENDAR_FEED_TOKEN=

# ==========================================
# DuckDNS auto-update (Pi only, optional but recommended until there's a DHCP reservation)
# ==========================================
# Used by scripts/update-duckdns-ip.sh, which runs on a systemd timer to keep the DuckDNS
# record pointed at the Pi's actual current local IP -- without a DHCP reservation on the
# router, that IP can change (a lease renewal, a reboot, etc.), and until it's manually
# noticed and fixed, nobody can reach the app at all even though nothing is actually broken.
# This makes a real DHCP reservation less urgent, but doesn't replace getting one eventually
# (see README). DUCKDNS_TOKEN is the same value already in the (git-ignored) Caddyfile.
DUCKDNS_DOMAIN=
DUCKDNS_TOKEN=
