# ==========================================
# OUTBOUND NOTIFICATION EMAIL (SMTP)
# ==========================================
# Used by server.js's simulateEmail() to send real outbound notification emails:
#   - New-user welcome email (badge ID / username / temporary PIN)
#   - PIN reset email
#
# Copy this file to ".env" (which is git-ignored) and fill in real values for your
# SMTP provider. If SMTP_HOST or SMTP_USER is left unset, the app falls back to
# logging emails to the console instead of sending them, so it is safe to leave
# these unconfigured during local development.

# Hostname of your SMTP server, e.g. smtp.gmail.com or smtp.sendgrid.net
SMTP_HOST=smtp.example.com

# SMTP port. Common values: 587 (STARTTLS), 465 (implicit TLS), 25 (unencrypted)
SMTP_PORT=587

# Whether to use implicit TLS. Set to "true" only when using port 465.
SMTP_SECURE=false

# Username used to authenticate with the SMTP server
SMTP_USER=notifications@example.com

# Password (or app-specific password / API key) for SMTP_USER
SMTP_PASS=change-me

# "From" address/display name used on outbound emails. Falls back to SMTP_USER if unset.
SMTP_FROM="LTA Tracker <notifications@example.com>"
